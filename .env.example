# ---------------------------------------------------------------------------
# Application settings — copy to `.env` and replace every CHANGE_ME.
#   cp .env.example .env   (or: make env)
# `.env` is gitignored. Standing Rule 10: never paste a real value anywhere.
#
# Every Symfony kernel loads this file (composer.json extra.runtime.dotenv_path),
# so it holds ONLY the five application roles' DSNs and the application secrets
# (V3-1(i), V4 batch B2b-1, 2026-09-16). The other two files:
#   .env.infra  compose bootstrap passwords, incl. owner and superuser (.env.infra.example)
#   .env.test   the schema owner's DSN, for migrations and the suite (.env.test.example)
# Never add an owner or superuser credential here: public/index.php refuses every
# request while it can see one, and bin/console refuses every non-migration command.
# ---------------------------------------------------------------------------

# --- DSNs consumed by backend/ ---------------------------------------------
# The passwords inside these DSNs must match the ERP_*_PASSWORD values in `.env.infra`.

# The isolation suite: through PgBouncer, as erp_app. ADR-002 "Verification" #1 —
# a suite that connects as the owner is green and meaningless.
APP_DATABASE_URL="postgresql://erp_app:CHANGE_ME_APP@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

# The same role, straight to Postgres with no pooling. Only the isolation suite
# uses it: a backend that has never had app.tenant_id set is the only place
# current_setting() genuinely returns NULL, and that is the state the
# fail-closed policy has to be proven against.
APP_DIRECT_DATABASE_URL="postgresql://erp_app:CHANGE_ME_APP@127.0.0.1:55432/erp?serverVersion=17&charset=utf8"


# The read-only agent role, same pooled endpoint.
AI_DATABASE_URL="postgresql://erp_ai:CHANGE_ME_AI@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

# The three pre-authentication principals. Separate credentials on separate
# connections, which is the whole point: no SQL the application emits can undo
# the separation, where SET LOCAL ROLE on one connection could.
AUTH_DATABASE_URL="postgresql://erp_auth:CHANGE_ME_AUTH@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"
AUTHLOG_DATABASE_URL="postgresql://erp_authlog:CHANGE_ME_AUTHLOG@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"
RATELIMIT_DATABASE_URL="postgresql://erp_ratelimit:CHANGE_ME_RATELIMIT@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

# --- Symfony ---------------------------------------------------------------
# config/packages/routing.yaml has referenced %env(DEFAULT_URI)% since the Flex
# recipe wrote it in W0-a, and nothing ever defined it. Latent, because env-var
# processors are lazy and no test builds the router -- it surfaced the first
# time `composer update` ran cache:clear, and it would otherwise have surfaced
# on the first HTTP request Output 4 serves.
DEFAULT_URI=http://localhost
APP_ENV=dev
APP_SECRET=CHANGE_ME_APP_SECRET
KERNEL_CLASS=App\Kernel

# --- Output 4 §7 — the token sign-in path -----------------------------------
# HS256 signing key for the access token (SECURITY_MODEL.md E-20). At least 32
# bytes: an HS256 key below the digest size leaves every other control on this
# path intact and forgeable. Rotating it invalidates every live token, which is
# the only revocation this wave has (API-O-13).
AUTH_TOKEN_SIGNING_KEY=CHANGE_ME_TOKEN_SIGNING_KEY

# HMAC key for `auth_lockout.email_hash`. The migration's own comment: "a keyed
# hash, never the address: the table would otherwise be an enumerable directory
# of who has ever tried to log in." Rotating it expires every lockout once.
AUTH_EMAIL_HASH_KEY=CHANGE_ME_EMAIL_HASH_KEY

# ---------------------------------------------------------------------------
# W0-a tenancy slice — copy to `.env` and replace every CHANGE_ME.
#   cp .env.example .env   (or: make env)
# `.env` is gitignored. Standing Rule 10: never paste a real value anywhere.
# ---------------------------------------------------------------------------

# Bootstrap superuser. Container-internal only; nothing in the app uses it.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER
POSTGRES_DB=erp

# ADR-002 §1 role 1 of 3 — owns the schema, runs migrations, never serves requests.
# Local stand-in for Neon's `neondb_owner`, but created NOSUPERUSER so that
# FORCE ROW LEVEL SECURITY is actually exercised.
DB_OWNER=neondb_owner
DB_OWNER_PASSWORD=CHANGE_ME_OWNER

# ADR-002 §1 role 2 of 3 — the Symfony app and workers. CRUD, RLS-bound, no BYPASSRLS.
ERP_APP_USER=erp_app
ERP_APP_PASSWORD=CHANGE_ME_APP

# ADR-002 §1 role 3 of 3 — the NL query agent. SELECT only, RLS-bound, no BYPASSRLS.
ERP_AI_USER=erp_ai
ERP_AI_PASSWORD=CHANGE_ME_AI

# Host ports.
POSTGRES_DIRECT_PORT=55432
PGBOUNCER_PORT=56432

# --- DSNs consumed by backend/ ---------------------------------------------
# Migrations: direct, unpooled, as the owner.
DATABASE_URL="postgresql://neondb_owner:CHANGE_ME_OWNER@127.0.0.1:55432/erp?serverVersion=17&charset=utf8"

# The isolation suite: through PgBouncer, as erp_app. ADR-002 "Verification" #1 —
# a suite that connects as the owner is green and meaningless.
APP_DATABASE_URL="postgresql://erp_app:CHANGE_ME_APP@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

# The same role, straight to Postgres with no pooling. Only the isolation suite
# uses it: a backend that has never had app.tenant_id set is the only place
# current_setting() genuinely returns NULL, and that is the state the
# fail-closed policy has to be proven against.
APP_DIRECT_DATABASE_URL="postgresql://erp_app:CHANGE_ME_APP@127.0.0.1:55432/erp?serverVersion=17&charset=utf8"


# The read-only agent role, same pooled endpoint.
AI_DATABASE_URL="postgresql://erp_ai:CHANGE_ME_AI@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

# --- Symfony ---------------------------------------------------------------
APP_ENV=dev
APP_SECRET=CHANGE_ME_APP_SECRET
KERNEL_CLASS=App\Kernel

# ---------------------------------------------------------------------------
# The schema owner's DSN — copy to `.env.test` and replace every CHANGE_ME.
#   cp .env.test.example .env.test   (or: make env)
# `.env.test` is gitignored. Standing Rule 10: never paste a real value anywhere.
#
# Why a separate file (V3-1(i), V4 batch B2b-1, 2026-09-16): every Symfony kernel
# loads the root `.env`, so the owner credential must not live there. This file
# is loaded only by:
#   - the test suite: tests/bootstrap.php runs Dotenv::bootEnv on the root `.env`
#     under APP_ENV=test, and loadEnv then reads `.env.test` by name;
#   - `make migrate`: APP_RUNTIME_OPTIONS={"dotenv_extra_paths":["../.env.test"]}
#     makes the runtime load it through PHP Dotenv for that one command. It is
#     never shell-sourced: shell would background at the unquoted `&` below and
#     expand any `$` in a password;
#   - `make reset`: bin/assert-clean-database.php reads it by explicit path.
# A web process that loads it refuses every request (public/index.php).
#
# Keep the value quoted.
# ---------------------------------------------------------------------------

# Migrations and the suite's owner fixtures: direct, unpooled, as the owner.
DATABASE_URL="postgresql://neondb_owner:CHANGE_ME_OWNER@127.0.0.1:55432/erp?serverVersion=17&charset=utf8"

# Mail-C1: the mail worker's login (`erp_worker`, owner Q-2), for the handler tests. Never in `.env` (the web process
# refuses to serve while it can see it). Its password must equal `.env.infra`'s ERP_WORKER_PASSWORD.
WORKER_DATABASE_URL="postgresql://erp_worker:CHANGE_ME_WORKER@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

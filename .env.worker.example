# ---------------------------------------------------------------------------
# The mail worker's settings (Mail-C0, 2026-10-23) — copy to `.env.worker` and replace every CHANGE_ME.
#   cp .env.worker.example .env.worker   (or: make env)
# `.env.worker` is gitignored. Standing Rule 10: never paste a real value anywhere.
#
# Read ONLY by `make worker` (bin/console with `dotenv_extra_paths: ../.env.worker`), never by the web front
# controller: the web process holds no SMTP credential and no worker database login. The mail transport moved to the
# root `.env` at Mail-C1, when the web process began dispatching (the worker reads `.env` too, so it has one source).
# ---------------------------------------------------------------------------

# Where the worker sends mail. Locally: the Mailpit container (`.env.infra` MAILPIT_SMTP_PORT). No default exists in
# config on purpose -- a missing value fails at the first send instead of dropping mail silently.
MAILER_DSN=smtp://127.0.0.1:51025
MAILER_FROM=no-reply@erp.local

# Mail-C1: the mail worker's database login (`erp_worker`, owner Q-2), through PgBouncer. Its password must equal
# `.env.infra`'s ERP_WORKER_PASSWORD. NEVER in `.env`: the web process refuses to serve while it can see it
# (ServingCredentialGuard, SERVING_WEB_ROLES).
WORKER_DATABASE_URL="postgresql://erp_worker:CHANGE_ME_WORKER@127.0.0.1:56432/erp?serverVersion=17&charset=utf8"

# Mail-C1: where a reset link points (the front end; the page itself is not built yet).
APP_PUBLIC_URL=http://127.0.0.1:5173

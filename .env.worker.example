# ---------------------------------------------------------------------------
# The mail worker's settings (Mail-C0, 2026-10-23) — copy to `.env.worker` and replace every CHANGE_ME.
#   cp .env.worker.example .env.worker   (or: make env)
# `.env.worker` is gitignored. Standing Rule 10: never paste a real value anywhere.
#
# Read ONLY by `make worker` (bin/console with `dotenv_extra_paths: ../.env.worker`), never by the web front
# controller: the web process holds no SMTP credential. The mail transport lives here and not in `.env` until Mail-C1,
# when the web process dispatches its first message (plan §R10 item 6).
# ---------------------------------------------------------------------------

# Where the worker sends mail. Locally: the Mailpit container (`.env.infra` MAILPIT_SMTP_PORT). No default exists in
# config on purpose -- a missing value fails at the first send instead of dropping mail silently.
MAILER_DSN=smtp://127.0.0.1:51025
MAILER_FROM=no-reply@erp.local

# The mail queue (Redis, `.env.infra` REDIS_PORT). The password must equal `.env.infra`'s REDIS_PASSWORD. NO PATH and no
# `stream`/`group` query: in the Redis bridge a DSN path overrides each transport's `options.stream`, which would put
# `async` and `failed` on ONE stream (mail-c0-red.md M-1; MessengerConfigurationTest::asyncAndFailedUseDistinctStreams).
MESSENGER_TRANSPORT_DSN=redis://:CHANGE_ME_REDIS@127.0.0.1:56379

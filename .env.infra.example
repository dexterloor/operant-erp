# ---------------------------------------------------------------------------
# Compose-only bootstrap settings — copy to `.env.infra` and replace every CHANGE_ME.
#   cp .env.infra.example .env.infra   (or: make env)
# `.env.infra` is gitignored. Standing Rule 10: never paste a real value anywhere.
#
# Read by `docker compose --env-file .env.infra` (the Makefile's COMPOSE) and by
# NO PHP entry point. It holds every password the database needs to bootstrap
# itself, including the schema owner's and the superuser's, so that none of them
# is loaded into a Symfony kernel (V3-1(i), V4 batch B2b-1, 2026-09-16). The web
# front controller refuses to serve while it can see a credential of this shape.
#
# The application-role passwords below must match the passwords inside the DSNs
# in the root `.env`; the owner password must match the DSN in `.env.test`.
# ---------------------------------------------------------------------------

# Bootstrap superuser. Used only inside the postgres container to run the init script.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER
POSTGRES_DB=erp

# ADR-002 §1 / A1.3 role 1 of 6 — owns the schema, runs migrations, never serves requests.
# Local stand-in for Neon's `neondb_owner`, but created NOSUPERUSER so that
# FORCE ROW LEVEL SECURITY is actually exercised.
DB_OWNER=neondb_owner
DB_OWNER_PASSWORD=CHANGE_ME_OWNER

# ADR-002 §1 / A1.3 role 2 of 6 — the Symfony app and workers. CRUD, RLS-bound, no BYPASSRLS.
ERP_APP_USER=erp_app
ERP_APP_PASSWORD=CHANGE_ME_APP

# ADR-002 §1 / A1.3 role 3 of 6 — the NL query agent. SELECT only, RLS-bound, no BYPASSRLS.
ERP_AI_USER=erp_ai
ERP_AI_PASSWORD=CHANGE_ME_AI

# ADR-006 §2 role 4 of 6 — pre-auth slug and credential read. No write anywhere.
ERP_AUTH_USER=erp_auth
ERP_AUTH_PASSWORD=CHANGE_ME_AUTH

# ADR-006 §2 role 5 of 6 — pre-auth audit write. INSERT on audit_log only, no SELECT on it.
ERP_AUTHLOG_USER=erp_authlog
ERP_AUTHLOG_PASSWORD=CHANGE_ME_AUTHLOG

# Role 6 of 6 — the pre-auth rate limiter and lockout counters. Not in ADR-006,
# which runs §2.1 step 1 on erp_app; that is the exposure ADR-006's own
# Condition 2 promotes to equal priority, because erp_app can write
# messenger_messages with no tenant context at all. Two counter tables, nothing else.
ERP_RATELIMIT_USER=erp_ratelimit
ERP_RATELIMIT_PASSWORD=CHANGE_ME_RATELIMIT

# Host ports.
POSTGRES_DIRECT_PORT=55432
PGBOUNCER_PORT=56432
